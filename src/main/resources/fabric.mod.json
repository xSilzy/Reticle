{
  "schemaVersion": 1,
  "id": "yazm",
  "version": "${version}",
  "name": "yet-another-zoom-mod",
  "description": "Yet another zoom mod with a lot of features!",
  "authors": ["Silzy"],
  "contact": {},
  "license": "GPLv3",
  "icon": "assets/yazm/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "dev.silzy.yazm.client.YazmDataGenerator"
    ],
    "client": [
      "dev.silzy.yazm.client.YazmClient"
    ],
    "main": [
      "dev.silzy.yazm.Yazm"
    ]
  },
  "mixins": [
    "yazm.mixins.json",
    {
      "config": "yazm.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "owo": "*"
  }
}
