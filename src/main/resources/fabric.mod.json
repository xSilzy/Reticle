{
  "schemaVersion": 1,
  "id": "reticle",
  "version": "${version}",
  "name": "Reticle",
  "description": "Reticle!",
  "authors": ["Silzy"],
  "contact": {},
  "license": "GPLv3",
  "icon": "assets/reticle/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "dev.silzy.reticle.client.ReticleDataGenerator"
    ],
    "client": [
      "dev.silzy.reticle.client.ReticleClient"
    ],
    "main": [
      "dev.silzy.reticle.Reticle"
    ]
  },
  "mixins": [
    "reticle.mixins.json",
    {
      "config": "reticle.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "owo": "*"
  }
}
